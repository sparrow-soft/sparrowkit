#!/usr/bin/env ruby
# frozen_string_literal: true

# The standard Rails stub, and it is load-bearing rather than boilerplate.
#
# `rails server` does not decide it is inside an application by finding
# config/application.rb. Rails::AppLoader walks up from the working directory
# looking for bin/rails or script/rails, and if it reaches the filesystem root
# without finding one it concludes you meant `rails new` -- so a host with a
# complete config/ and no bin/rails answers every command with the generator's
# help, which reads as a broken install rather than a missing file.

APP_PATH = File.expand_path("../config/application", __dir__)
require_relative "../config/boot"
require "rails/commands"
