# Copy to .env.smoke and fill in. .env.smoke is gitignored and is never read by
# anything except bin/smoke.
#
#   cp .env.smoke.example .env.smoke
#   bin/smoke --dry-run     # check the plan
#   bin/smoke               # send

# Required.
SENDLAYER_API_KEY=

# Must be an address SendLayer has authorised for the account, or every send
# fails on the sender rather than on anything this gem did.
SMOKE_FROM=Your App Smoke Test <no-reply@yourdomain.com>

# An inbox you can actually read, because half the checks are things only a
# received message can settle.
SMOKE_TO=

# Optional. A second inbox you can read, to prove bcc delivery and that the bcc
# address stays out of the headers.
SMOKE_BCC=

# Optional. A second SendLayer key, so the broadcast stream has its own sending
# identity. Without it the run uses shared_identity: true, which exercises the
# routing but not real reputation separation.
SMOKE_BROADCAST_KEY=

# Optional. SendLayer also offers SMTP, which is the only way to exercise the
# SMTP adapter live, including the MIME rebuild that a control header triggers
# and the Bcc restatement that goes with it.
SMOKE_SMTP_HOST=
SMOKE_SMTP_PORT=587
SMOKE_SMTP_USERNAME=
SMOKE_SMTP_PASSWORD=
