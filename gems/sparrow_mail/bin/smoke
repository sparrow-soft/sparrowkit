puts "\n#{BOLD}Summary#{RESET}"
puts "  #{GREEN}#{RESULTS[:pass]} passed#{RESET}  " \
     "#{RESULTS[:fail].positive? ? RED : DIM}#{RESULTS[:fail]} failed#{RESET}  " \
     "#{RESULTS[:warn].positive? ? YELLOW : DIM}#{RESULTS[:warn]} warnings#{RESET}  " \
     "#{DIM}#{RESULTS[:skip]} skipped#{RESET}"

unless FAILURES.empty?
  puts "\n#{RED}Failures#{RESET}"
  FAILURES.each { |f| puts "  - #{f}" }
end

puts <<~CHECKLIST

  #{BOLD}Now check the inbox at #{TO}#{RESET}
  #{DIM}Everything above is what the API accepted. These are the things only a
  received message can settle. Search for "#{RUN_ID}"; every body carries it.#{RESET}

    [ ] 8 messages arrived (7 if SMOKE_BCC is unset)
    [ ] "Held in sandbox, must not arrive" is NOT among them
    [ ] "Welcome to SparrowSoft" renders as a heading, not raw markup
    [ ] "Your export is ready" has export-#{RUN_ID}.csv attached, and it opens
    [ ] "Código de acceso · 確認 · Grüße" displays correctly in the subject line
    [ ] "Your receipt" arrived at #{BCC || "(bcc not configured)"} as well
    [ ] "Your receipt" raw source does NOT list #{BCC || "the bcc address"} in a header

  #{BOLD}In the raw source of any received message#{RESET}
  #{DIM}Find the Authentication-Results header. It settles in one line whether
  this is an authentication problem or a reputation one.#{RESET}

    [ ] spf=pass       (or spf=none if you have not added an SPF record yet)
    [ ] dkim=pass      header.d=#{FROM_DOMAIN}
    [ ] dmarc=pass

  #{DIM}dkim=pass with header.d set to some other domain is the giveaway that the
  API key belongs to a different account than #{FROM_DOMAIN}. That fails DMARC
  alignment on its own, and with no SPF record there is nothing else left to
  pass on.#{RESET}

  #{BOLD}In the raw source of "Your monthly summary"#{RESET}

    [ ] X-Smoke-Run: #{RUN_ID} is present
    [ ] X-Sparrow-Tags is ABSENT
    [ ] X-Sparrow-Metadata is ABSENT
    [ ] X-Sparrow-Stream is ABSENT

  #{DIM}That last group is the one worth doing carefully. Control-header
  stripping changed recently, and a received message is the only thing that
  proves it for the transports that send raw MIME.#{RESET}

CHECKLIST

exit(RESULTS[:fail].zero? ? 0 : 1)
