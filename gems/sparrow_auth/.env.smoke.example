# Copy to .env.smoke and fill in. .env.smoke is gitignored and is read by
# nothing except bin/smoke.
#
#   cp .env.smoke.example .env.smoke
#   bin/smoke --dry-run
#   bin/smoke
#
# Everything here is optional. With none of it set, bin/smoke still runs the
# whole flow and reads the auth emails in-process through sparrow_mail's test
# adapter. Setting it additionally sends those emails to a real inbox, so you
# can read what an actual person would receive.

SENDLAYER_API_KEY=
SMOKE_FROM=Your App <no-reply@yourdomain.com>
SMOKE_TO=

# The database bin/smoke creates, migrates from empty, and drops again. It must
# not be a database you care about; it is dropped at the start of every run.
SPARROW_AUTH_SMOKE_DB=sparrow_auth_smoke

# Pin the port if you want a stable URL for --server. Otherwise one is chosen.
SMOKE_PORT=
