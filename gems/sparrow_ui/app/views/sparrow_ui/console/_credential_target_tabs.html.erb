<%# The server owns the allow-list; these ordinary links work without JavaScript. %>
<div class="flex flex-wrap items-center gap-1">
  <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Credentials</span>
  <nav aria-label="Credential target" class="flex min-w-0 items-center gap-1 rounded-md border border-slate-300 p-0.5 dark:border-slate-700">
    <% SparrowUi::Console::Settings::TARGETS.each_key do |target_name| %>
      <% target = SparrowUi::Console::Settings.resolve_target(target_name) %>
      <% current = credential_target.name == target.name %>
      <% if current %>
        <a href="<%= request.path %>?credential_target=<%= target.name %>" aria-current="page" class="rounded px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-purple-900 aria-[current=page]:bg-slate-100 aria-[current=page]:text-purple-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-purple-300 dark:aria-[current=page]:bg-slate-800 dark:aria-[current=page]:text-purple-300"><%= target.label %></a>
      <% else %>
        <a href="<%= request.path %>?credential_target=<%= target.name %>" class="rounded px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-purple-900 aria-[current=page]:bg-slate-100 aria-[current=page]:text-purple-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-purple-300 dark:aria-[current=page]:bg-slate-800 dark:aria-[current=page]:text-purple-300"><%= target.label %></a>
      <% end %>
    <% end %>
  </nav>
</div>
